# Образец настроек. Скопируйте в .env и при необходимости измените:
#   cp .env.example .env

# База данных
POSTGRES_DB=atmosfera
POSTGRES_USER=atmosfera
POSTGRES_PASSWORD=atmosfera

# Порт, на котором сайт доступен снаружи
APP_PORT=80

# Каталоги миграций Flyway: схема + тестовые данные
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/testdata

# Адрес сайта для ссылок в письмах (порт 80 указывать не нужно)
APP_BASE_URL=http://localhost